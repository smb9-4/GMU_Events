# Copy this file to ".env" and fill in your values.

# Your MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/gmu_tedx
# Any long random string (used to sign login sessions). Change it!
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters

PORT=3000

# The first admin account is created automatically on startup if it does not exist.
ADMIN_NAME=TEDx Admin
ADMIN_EMAIL=admin@gmu.ac.in
ADMIN_PASSWORD=replace-with-a-strong-password
