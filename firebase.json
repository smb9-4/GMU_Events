{
  "hosting": {
    "public": "public",
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/@(admin|student|volunteer|event|event-details|ticket)?(.html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, private"
          }
        ]
      }
    ]
  }
}
